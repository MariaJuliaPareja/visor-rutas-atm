# Plantilla de configuracion del pipeline. Copiala como .env (ignorado por git) y ajusta los valores.
# Ningun valor real va en este archivo.

# simulado = recocido simulado local | qpu = D-Wave Leap | ibm = QAOA en IBM Quantum (ambos consumen minutos, RNF04)
RUTAS_SAMPLER=simulado
RUTAS_NUM_READS=200
RUTAS_SEMILLA=42
# Tiempo de recocido por lectura en el QPU, en microsegundos (solo con qpu)
RUTAS_ANNEALING_TIME=20
# linea_recta = haversine (sin internet) | vial = por calles de OpenStreetMap con OSRM
RUTAS_DISTANCIA=linea_recta
# RUTAS_OSRM_URL=https://router.project-osrm.org
RUTAS_DIR_SALIDA=salidas
RUTAS_NIVEL_LOG=INFO

# Solo con RUTAS_SAMPLER=qpu. Alternativa recomendada: `dwave config create`, que lo guarda fuera del repo.
# DWAVE_API_TOKEN=<tu-token-de-leap>

# Solo con RUTAS_SAMPLER=ibm. Capas de QAOA y backend fijo (vacio = el menos ocupado).
RUTAS_QAOA_REPS=1
# RUTAS_IBM_BACKEND=ibm_brisbane
# Alternativa a QiskitRuntimeService.save_account(...), que lo guarda fuera del repo:
# QISKIT_IBM_TOKEN=<tu-api-key-de-ibm-cloud>
# QISKIT_IBM_INSTANCE=<crn-de-tu-instancia>

# Cajeros reales (OpenStreetMap). sintetica = puntos ficticios | osm = catalogo descargado con --descargar-cajeros
RUTAS_FUENTE=sintetica
RUTAS_CATALOGO=datos/cajeros_bbva_arequipa.json
# Base de operaciones del camion (latitud,longitud) y radio de busqueda de cajeros en km
RUTAS_BASE=-16.3989,-71.5350
RUTAS_RADIO_KM=4

